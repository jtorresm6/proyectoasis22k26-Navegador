    </ComponenteVentas>
    <ComponenteVentas Include="..\..\componentes\seguridad\Ejecucion_Seguridad\Ejecucion_Seguridad\Ejecucion_Seguridad.csproj">
      <AdditionalProperties>SolutionDir=$(MSBuildThisFileDirectory)..\..\componentes\seguridad\Ejecucion_Seguridad\</AdditionalProperties>
      <Biblioteca>Ejecucion_Seguridad.exe</Biblioteca>
    </ComponenteVentas>
    <ComponenteVentas Include="..\..\componentes\reporteador\Ejecucion_Reporteador\Ejecucion_Reporteador\Ejecucion_Reporteador.csproj">
      <AdditionalProperties>SolutionDir=$(MSBuildThisFileDirectory)..\..\componentes\reporteador\Ejecucion_Reporteador\</AdditionalProperties>
      <Biblioteca>Ejecucion_Reporteador.exe</Biblioteca>
    </ComponenteVentas>
  </ItemGroup>
  <Target Name="CompilarComponentesVentas">
    <Error Condition="!Exists('%(ComponenteVentas.Identity)')" Text="Falta el proyecto del componente: %(ComponenteVentas.Identity)" />
    <Message Text="[1/8] Compilando con los paquetes locales de cada solucion..." Importance="high" />
    <Message Text="[2/8] Consultas: Modelo, Controlador y Vista..." Importance="high" />
    <MSBuild Projects="@(ConsultasModelo)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(ConsultasControlador)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(ConsultasVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <Message Text="[3/8] Seguridad: Modelo y Controlador que necesita Navegador..." Importance="high" />
    <MSBuild Projects="@(SeguridadModelo)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(SeguridadControlador)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <Message Text="[4/8] Botones de Reporteador: Actualizar, Busqueda, Editar, Eliminar, Guardar, Limpiar, Ruta y Ver reporte..." Importance="high" />
    <MSBuild Projects="@(BotonesModelo)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(BotonesControlador)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(BotonesVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(BotonGuardarVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <Message Text="[5/8] Reporteador: sus tres capas despues de todos los botones..." Importance="high" />
    <MSBuild Projects="@(ReporteadorModelo)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(ReporteadorControlador)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(ReporteadorVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <Message Text="[6/8] Navegador..." Importance="high" />
    <MSBuild Projects="@(NavegadorModelo)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(NavegadorControlador)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(NavegadorAuxiliar)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(NavegadorVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <CallTarget Targets="CompilarLogisticaVentas" />
    <CallTarget Targets="CompilarFormulariosVentas" />
    <MSBuild Projects="VentasYCxC\CapaVista_Ventas\CapaVista_Ventas.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" StopOnFirstFailure="true" />
    <MSBuild Projects="@(SeguridadVista)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(EjecutableComponente)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
  </Target>
  <Target Name="CompilarLogisticaVentas">
    <Message Text="[7/8] Logistica y sus formularios antes de Vista de Seguridad..." Importance="high" />
    <MSBuild Projects="@(LogisticaModeloVentas)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(LogisticaControladorVentas)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(LogisticaVistaVentas)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <!-- Transporte Interno usa Transporte Externo; el MDI usa todas las vistas. -->
    <MSBuild Projects="@(LogisticaTransporteInternoVentas)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" StopOnFirstFailure="true" />
    <MSBuild Projects="@(LogisticaMdiVentas)" Targets="Build" Properties="$(PropiedadesComponentesVentas)" StopOnFirstFailure="true" />
  </Target>
</Project>
