    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaControlador_Reportes_Ventas\bin\$(Configuration)\CapaControlador_Reportes_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaModelo_Reportes_Ventas\bin\$(Configuration)\CapaModelo_Reportes_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_Reportes_Ventas\bin\$(Configuration)\CapaVista_Reportes_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaControlador_Mantenimientos_Ventas\bin\$(Configuration)\CapaControlador_Mantenimientos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaModelo_Mantenimientos_Ventas\bin\$(Configuration)\CapaModelo_Mantenimientos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaVista_Mantenimientos_Ventas\bin\$(Configuration)\CapaVista_Mantenimientos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaControlador_ComisionVendedores_Ventas\bin\$(Configuration)\CapaControlador_ComisionVendedores_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaModelo_ComisionVendedores_Ventas\bin\$(Configuration)\CapaModelo_ComisionVendedores_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaVista_ComisionVendedores_Ventas\bin\$(Configuration)\CapaVista_ComisionVendedores_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaControlador_Pedidos_Ventas\bin\$(Configuration)\CapaControlador_Pedidos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaModelo_Pedidos_Ventas\bin\$(Configuration)\CapaModelo_Pedidos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaVista_Pedidos_Ventas\bin\$(Configuration)\CapaVista_Pedidos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaControlador_Ventas\bin\$(Configuration)\CapaControlador_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaModelo_Ventas\bin\$(Configuration)\CapaModelo_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaVista_Ventas\bin\$(Configuration)\CapaVista_Ventas.dll" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\CapaControlador_Facturas_Ventas\bin\$(Configuration)\CapaControlador_Facturas_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\CapaModelo_Facturas_Ventas\bin\$(Configuration)\CapaModelo_Facturas_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\CapaVista_Facturas_Ventas\bin\$(Configuration)\CapaVista_Facturas_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ListadoPrecios_Ventas\CapaControlador_ListadoPrecios_Ventas\bin\$(Configuration)\CapaControlador_ListadoPrecios_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ListadoPrecios_Ventas\CapaModelo_ListadoPrecios_Ventas\bin\$(Configuration)\CapaModelo_ListadoPrecios_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ListadoPrecios_Ventas\CapaVista_ListadoPrecios_Ventas\bin\$(Configuration)\CapaVista_ListadoPrecios_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaControlador_Cotizaciones_Ventas\bin\$(Configuration)\CapaControlador_Cotizaciones_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaModelo_Cotizaciones_Ventas\bin\$(Configuration)\CapaModelo_Cotizaciones_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaVista_Cotizaciones_Ventas\bin\$(Configuration)\CapaVista_Cotizaciones_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaControlador_MovimientosClientes_Ventas\bin\$(Configuration)\CapaControlador_MovimientosClientes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaModelo_MovimientosClientes_Ventas\bin\$(Configuration)\CapaModelo_MovimientosClientes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaVista_MovimientosClientes_Ventas\bin\$(Configuration)\CapaVista_MovimientosClientes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaControlador_CierreMovimientos_Ventas\bin\$(Configuration)\CapaControlador_CierreMovimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaModelo_CierreMovimientos_Ventas\bin\$(Configuration)\CapaModelo_CierreMovimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaVista_CierreMovimientos_Ventas\bin\$(Configuration)\CapaVista_CierreMovimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaControlador_Reportes_Ventas\bin\$(Configuration)\CapaControlador_Reportes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaModelo_Reportes_Ventas\bin\$(Configuration)\CapaModelo_Reportes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_Reportes_Ventas\bin\$(Configuration)\CapaVista_Reportes_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaControlador_Mantenimientos_Ventas\bin\$(Configuration)\CapaControlador_Mantenimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaModelo_Mantenimientos_Ventas\bin\$(Configuration)\CapaModelo_Mantenimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaVista_Mantenimientos_Ventas\bin\$(Configuration)\CapaVista_Mantenimientos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaControlador_ComisionVendedores_Ventas\bin\$(Configuration)\CapaControlador_ComisionVendedores_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaModelo_ComisionVendedores_Ventas\bin\$(Configuration)\CapaModelo_ComisionVendedores_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaVista_ComisionVendedores_Ventas\bin\$(Configuration)\CapaVista_ComisionVendedores_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaControlador_Pedidos_Ventas\bin\$(Configuration)\CapaControlador_Pedidos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaModelo_Pedidos_Ventas\bin\$(Configuration)\CapaModelo_Pedidos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaVista_Pedidos_Ventas\bin\$(Configuration)\CapaVista_Pedidos_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaControlador_Ventas\bin\$(Configuration)\CapaControlador_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaModelo_Ventas\bin\$(Configuration)\CapaModelo_Ventas.pdb" />
    <SimboloVentas Include="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaVista_Ventas\bin\$(Configuration)\CapaVista_Ventas.pdb" />
  </ItemGroup>
  <Import Project="build_componentes_ventas.proj" />
  <ItemGroup>
    <ProyectoNuGetVentas Include="..\Biblioteca de clase Ventas Y CxC\**\Capa*\*.csproj;..\Ejecutable_Ventas\Ejecutable_Ventas\Ejecucion_Ventas.csproj" />
  </ItemGroup>
  <Target Name="RestaurarDependenciasVentas">
    <MSBuild Projects="@(ProyectoNuGetVentas)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=AnyCPU;RestorePackagesConfig=false" BuildInParallel="true" StopOnFirstFailure="true" />
  </Target>
  <Target Name="PrepararDependenciasVentas" DependsOnTargets="ValidarConfiguracion;RestaurarDependenciasVentas;CompilarComponentesVentas;ValidarSeguridadVentas" />
  <Target Name="ValidarSeguridadVentas">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\componentes\seguridad\Seguridad\CapaVista_Seguridad\bin\$(Configuration)\CapaVista_Seguridad.dll')" Text="Falta CapaVista_Seguridad.dll del perfil $(Configuration). Compile el login compartido de Seguridad con sus dependencias para iniciar Ventas." />
  </Target>
  <Target Name="Compilar" DependsOnTargets="PrepararDependenciasVentas">
    <Message Text="[8/8] Compilando el ejecutable de Ventas ($(Configuration))..." Importance="high" />
    <MSBuild Projects="..\Ejecutable_Ventas\Ejecutable_Ventas\Ejecucion_Ventas.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <CallTarget Targets="ReunirBibliotecas" />
  </Target>
  <Target Name="CompilarFormulariosVentas">
    <Message Text="Compilando formularios MVC de Ventas antes de enlazar el MDI..." Importance="high" />
    <MSBuild Projects="..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaModelo_Ventas\CapaModelo_Ventas.csproj;..\Biblioteca de clase Ventas Y CxC\VentasYCxC_Ventas\CapaControlador_Ventas\CapaControlador_Ventas.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" BuildInParallel="false" StopOnFirstFailure="true" />
    <MSBuild Projects="@(SolucionVentas->'%(RelativeDir)CapaModelo_%(Filename)_Ventas\CapaModelo_%(Filename)_Ventas.csproj')" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(SolucionVentas->'%(RelativeDir)CapaControlador_%(Filename)_Ventas\CapaControlador_%(Filename)_Ventas.csproj')" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
    <MSBuild Projects="@(SolucionVentas->'%(RelativeDir)CapaVista_%(Filename)_Ventas\CapaVista_%(Filename)_Ventas.csproj')" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;$(OpcionesReferenciasVentas)" BuildInParallel="true" StopOnFirstFailure="true" />
  </Target>
  <Target Name="ValidarConfiguracion">
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="Configuración no válida. Use Debug o Release." />
  </Target>
  <Target Name="ReunirBibliotecas">
    <Error Condition="!Exists('$(BCryptSeguridad)')" Text="Falta BCrypt-Net-Next.dll (4.2.0), requerida para el inicio de sesión. Revise el paquete de Seguridad en: $(BCryptSeguridad)" />
    <MakeDir Directories="$(SalidaVentas)" />
    <Error Condition="!Exists('%(BibliotecaVentas.Identity)')" Text="Falta la biblioteca compilada: %(BibliotecaVentas.Identity)" />
    <Copy SourceFiles="@(BibliotecaVentas)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SimboloVentas)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" Condition="Exists('%(SimboloVentas.Identity)')" />
    <ItemGroup>
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\ListadoPrecios_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\ListadoPrecios_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Mantenimientos_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\ComisionVendedores_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaVista_*\bin\$(Configuration)\System*.dll" />
      <DependenciaVentas Include="..\Biblioteca de clase Ventas Y CxC\Pedidos_Ventas\CapaVista_*\bin\$(Configuration)\Microsoft*.dll" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(DependenciaVentas)">
      <Output TaskParameter="Filtered" ItemName="DependenciaUnicaVentas" />
    </RemoveDuplicates>
    <Copy SourceFiles="@(DependenciaUnicaVentas)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Nativox64 Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_Reportes_Ventas\bin\$(Configuration)\x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Nativox64)" DestinationFolder="$(SalidaVentas)x64\" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Nativox86 Include="..\Biblioteca de clase Ventas Y CxC\Reportes_Ventas\CapaVista_Reportes_Ventas\bin\$(Configuration)\x86\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Nativox86)" DestinationFolder="$(SalidaVentas)x86\" SkipUnchangedFiles="true" />
    <ItemGroup>
      <BibliotecaComponenteVentas Include="@(ComponenteVentas->'%(RootDir)%(Directory)bin\$(Configuration)\%(Biblioteca)')" Condition="'%(ComponenteVentas.Extension)' == '.csproj'" />
      <DependenciaComponenteVentas Include="..\..\..\componentes\seguridad\Seguridad\CapaVista_Seguridad\bin\$(Configuration)\*.dll;..\..\..\componentes\reporteador\Reporteador\CapaVista_Reporteador\bin\$(Configuration)\*.dll;..\..\..\componentes\reporteador\BtnVerReporte_Reporteador\CapaVista_BtnVerReporte_Reporteador\bin\$(Configuration)\*.dll" />
      <NativoComponenteX64 Include="..\..\..\componentes\reporteador\Reporteador\CapaVista_Reporteador\bin\$(Configuration)\x64\*.dll;..\..\..\componentes\seguridad\Seguridad\CapaVista_Seguridad\bin\$(Configuration)\x64\*.dll" />
      <NativoComponenteX86 Include="..\..\..\componentes\reporteador\Reporteador\CapaVista_Reporteador\bin\$(Configuration)\x86\*.dll;..\..\..\componentes\seguridad\Seguridad\CapaVista_Seguridad\bin\$(Configuration)\x86\*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(BibliotecaComponenteVentas.Identity)')" Text="Falta la biblioteca del componente: %(BibliotecaComponenteVentas.Identity)" />
    <Copy SourceFiles="@(DependenciaComponenteVentas)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(BCryptSeguridad)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BibliotecaComponenteVentas)" DestinationFolder="$(SalidaVentas)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativoComponenteX64)" DestinationFolder="$(SalidaVentas)x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativoComponenteX86)" DestinationFolder="$(SalidaVentas)x86\" SkipUnchangedFiles="true" />
    <Delete Files="$(SalidaVentas)CapaRecursos_Ventas.dll;$(SalidaVentas)CapaRecursos_Ventas.pdb" />
    <ItemGroup Condition="'$(VentasDllCompartidas)' != ''">
      <DependenciaCompartida Include="$(VentasDllCompartidas)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="%(DependenciaCompartida.Identity)" DestinationFolder="$(SalidaVentas)" Condition="!Exists('$(SalidaVentas)%(DependenciaCompartida.Filename)%(DependenciaCompartida.Extension)')" SkipUnchangedFiles="true" />
    <Message Text="Ventas listo. DLL de los módulos reunidas en $(SalidaVentas)" Importance="high" />
  </Target>
</Project>
