    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\Cotizaciones_Ventas\CapaVista_Cotizaciones_Ventas\bin\$(Configuration)\CapaVista_Cotizaciones_Ventas.dll" />
