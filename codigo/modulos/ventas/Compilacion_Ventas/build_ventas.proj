<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0" DefaultTargets="Compilar">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <VentasDllCompartidas Condition="'$(VentasDllCompartidas)' == ''">$(MSBuildThisFileDirectory)..\..\..\componentes\seguridad\Seguridad\CapaVista_Seguridad\bin\$(Configuration)</VentasDllCompartidas>
    <SalidaVentas>$(MSBuildThisFileDirectory)..\Ejecutable_Ventas\Ejecutable_Ventas\bin\$(Configuration)\</SalidaVentas>
    <BCryptSeguridad>$(MSBuildThisFileDirectory)..\..\..\componentes\seguridad\Seguridad\packages\BCrypt.Net-Next.4.2.0\lib\net48\BCrypt-Net-Next.dll</BCryptSeguridad>
    <OpcionesReferenciasVentas>PlatformTarget=AnyCPU;BuildProjectReferences=false;VentasDependenciasPreparadas=true;CustomBeforeMicrosoftCommonTargets=$(MSBuildThisFileDirectory)build_componentes_ventas.targets</OpcionesReferenciasVentas>
  </PropertyGroup>
  <ItemGroup>
    <SolucionVentas Include="..\Biblioteca de clase Ventas Y CxC\Facturas_Ventas\Facturas.sln" />
