    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\MovimientosClientes_Ventas\CapaVista_MovimientosClientes_Ventas\bin\$(Configuration)\CapaVista_MovimientosClientes_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaControlador_CierreMovimientos_Ventas\bin\$(Configuration)\CapaControlador_CierreMovimientos_Ventas.dll" />
    <BibliotecaVentas Include="..\Biblioteca de clase Ventas Y CxC\CierreMovimientos_Ventas\CapaModelo_CierreMovimientos_Ventas\bin\$(Configuration)\CapaModelo_CierreMovimientos_Ventas.dll" />
