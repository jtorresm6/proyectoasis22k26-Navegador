  <Page>
    <PageHeader>
      <Height>2cm</Height>
      <PrintOnFirstPage>true</PrintOnFirstPage>
      <PrintOnLastPage>true</PrintOnLastPage>
      <ReportItems>
        <Textbox Name="TituloReporte">
          <CanGrow>true</CanGrow>
          <KeepTogether>true</KeepTogether>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>Bitácora de compras</Value>
                  <Style>
                    <FontFamily>Segoe UI</FontFamily>
                    <FontSize>20pt</FontSize>
                    <Color>#1E2A5A</Color>
                    <FontWeight>Bold</FontWeight>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Left>0cm</Left>
          <Top>0.1cm</Top>
          <Width>22cm</Width>
          <Height>0.85cm</Height>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
            <VerticalAlign>Middle</VerticalAlign>
          </Style>
        </Textbox>
        <Textbox Name="EtiquetaCompras">
          <CanGrow>true</CanGrow>
          <KeepTogether>true</KeepTogether>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>COMPRAS</Value>
                  <Style>
                    <FontFamily>Segoe UI</FontFamily>
                    <FontSize>11pt</FontSize>
                    <Color>#D9913E</Color>
                    <FontWeight>Bold</FontWeight>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Right</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Left>22cm</Left>
          <Top>0.1cm</Top>
          <Width>4.7cm</Width>
          <Height>0.85cm</Height>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
            <VerticalAlign>Middle</VerticalAlign>
          </Style>
        </Textbox>
        <Textbox Name="ResumenReporte">
          <CanGrow>true</CanGrow>
          <KeepTogether>true</KeepTogether>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>= "Listado de " &amp; CountRows("RpReporteBitacora") &amp; " registros de bitácora"</Value>
                  <Style>
                    <FontFamily>Segoe UI</FontFamily>
                    <FontSize>9pt</FontSize>
                    <Color>#3D56A6</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Left>0cm</Left>
          <Top>1cm</Top>
          <Width>19cm</Width>
          <Height>0.55cm</Height>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
            <VerticalAlign>Middle</VerticalAlign>
          </Style>
